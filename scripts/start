#!/usr/bin/env bash
# ./demo start — see ../README.md. Brings the whole appliance up with one
# command: Aerospike, the one-shot dataset generator, the Java backend
# (which loads that data and creates indexes on first boot), and the
# frontend. Safe to re-run — every step here is idempotent.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

ok()   { printf '\033[32m✓\033[0m %s\n' "$1"; }
fail() { printf '\033[31m✗\033[0m %s\n' "$1" >&2; exit 1; }

command -v docker >/dev/null 2>&1 || fail "Docker not found — install Docker Desktop and try again."
docker info >/dev/null 2>&1 || fail "Docker isn't running — start Docker Desktop and try again."
docker compose version >/dev/null 2>&1 || fail "docker compose (v2) isn't available.

This script uses the 'docker compose' plugin, not the old standalone
'docker-compose' binary. This is confirmed to happen with Homebrew's
plain 'docker' formula (no Docker Desktop, no ~/.docker/cli-plugins/
directory) — the compose plugin is a separate install that Homebrew
doesn't symlink into place for you. Fix:

  brew install docker-compose
  mkdir -p ~/.docker/cli-plugins
  ln -sfn \"\$(brew --prefix)/opt/docker-compose/bin/docker-compose\" \\
      ~/.docker/cli-plugins/docker-compose
  docker compose version   # should now print a version

If that's not it, run 'docker compose version' directly to see the
real underlying error, and check 'alias | grep docker' — a shell
alias wrapping 'docker' can break subcommand parsing the same way."
ok "Checking Docker"

# If someone's dropped an internal/unreleased server RPM in at
# local/server.rpm (see local/README.md) but hasn't set up the override that
# activates it yet, generate it now. This is the entire "how do I turn on
# real AEL" setup: place one file, run ./demo start — nothing to hand-edit.
# Never overwrites an override that's already there (someone may have
# customized it), and does nothing at all when local/server.rpm is absent —
# the default public-image path is completely unaffected either way.
if [ -f local/server.rpm ] && [ ! -f docker-compose.override.yml ]; then
  cat > docker-compose.override.yml <<'EOF'
# LOCAL-ONLY — gitignored, not part of the public repo, auto-generated by
# scripts/start because local/server.rpm was present. Points the aerospike
# service at a custom image built from that RPM instead of the public
# 8.1.2.4 image, so the demo's real AEL/indexed path runs for real. Delete
# this file (or delete local/server.rpm) to fall back to the public image.
services:
  aerospike:
    image: aerospike-dx-demo-aerospike:local
    build:
      context: local
    volumes:
      # Full replacement of docker-compose.yml's volumes list, not an
      # addition — compose merges sequences by replacing, not concatenating.
      # This image runs asd directly against the real config path; no
      # vendor entrypoint template step like the public image needs, so
      # this mounts at aerospike.conf itself, not aerospike.template.conf.
      - ./aerospike/aerospike.conf:/etc/aerospike/aerospike.conf:ro
    healthcheck:
      # asinfo isn't in the community server RPM (it ships separately in
      # aerospike-tools), so this is a plain TCP check instead of
      # docker-compose.yml's `asinfo -v status` — a weaker proxy, fine for
      # local-only testing.
      test: ["CMD-SHELL", "bash -c '</dev/tcp/127.0.0.1/3000'"]
      interval: 3s
      timeout: 3s
      retries: 30
EOF
  ok "Detected local/server.rpm — using it for the aerospike service"
fi

# One call. Compose brings services up in dependency order and, for every
# service declaring `condition: service_healthy`, blocks until that
# healthcheck passes: aerospike's asinfo check, then backend's own /health
# — which only reports healthy once data is loaded AND every index has
# reached RW. By the time this returns, everything below has already
# happened; the checkmarks are reporting that, not narrating a guess.
#
# --force-recreate, not just --build: confirmed the hard way (twice) that
# without it, swapping the aerospike image while backend is already running
# leaves backend on a stale connection reporting the *previous* server's
# version and erroring on every query, since compose only recreates a
# service whose own config/image actually changed - backend's didn't, only
# aerospike's did. Forcing every service to recreate costs a few seconds of
# container churn even when nothing changed; that's a fair trade for this
# demo never landing back in that broken state on a routine restart.
if ! docker compose up -d --build --force-recreate; then
  fail "Startup failed — run './demo logs' to see why."
fi
ok "Starting Aerospike"
ok "Starting booking application"
ok "Loading demo data"
ok "Creating indexes"
ok "Waiting for indexes → RW"
ok "Starting web application"

scripts/health 15 >/dev/null || fail "Backend didn't report healthy — run './demo logs backend'."

cat <<'EOF'

Demo ready!

Open:
  http://localhost:8080

Demo controls:
  ./demo reset
  ./demo seed
  ./demo status
  ./demo logs
  ./demo stop
EOF
